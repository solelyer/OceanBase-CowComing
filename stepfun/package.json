    "test": "node --test tests/contracts.test.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "seekdb": "1.4.0"
  },
  "devDependencies": { "vite": "7.3.7", "playwright": "1.58.2" },
  "overrides": { "adm-zip": "0.6.1", "esbuild": "0.28.1" }
}
