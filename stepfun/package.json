{
  "name": "near-knowledge-browser",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "prepare:model": "node scripts/download-model.mjs",
    "db:start": "node scripts/start-database.mjs",
    "db:wait": "node scripts/wait-database.mjs",
